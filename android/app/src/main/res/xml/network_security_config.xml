<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Muchas emisoras del directorio de Radio Browser transmiten solo por
         HTTP, así que se permite el tráfico sin cifrar para reproducirlas.
         La API del directorio se consulta siempre por HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
